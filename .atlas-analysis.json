  "keyFeatures": [
    "Dual-module system for printer and computer fault reporting",
    "Automated email notifications with Excel attachments",
    "ORBE HTML ticket parsing and integration",
    "Smart autocomplete for assets, buildings, departments, and IT staff",
    "Multi-stage report lifecycle management (reportado, coordinado, en_espera, taller, cerrado)",
    "MongoDB-based persistent storage",
    "Real-time status tracking and history"
  ],
  "publicApiSurface": [
    "POST /api/reports - Create new fault report",
    "GET /api/reports - List all reports",
    "PATCH /api/reports/{id}/estado - Update report status",
    "GET /api/autocomplete/activos - Asset autocomplete",
    "GET /api/autocomplete/edificios - Building autocomplete",
    "GET /api/autocomplete/departamentos - Department autocomplete",
    "GET /api/autocomplete/informaticos - IT staff autocomplete",
    "GET /api/informatico/email/{nombre} - Get IT staff email",
    "POST /api/parse-boleta - Parse ORBE HTML ticket",
    "POST /api/smtp/configure - Configure SMTP settings",
    "POST /api/status - Create status check",
    "GET /api/status - List status checks"
  ]
